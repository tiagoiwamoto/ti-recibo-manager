{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "useDefineForClassFields": false,
    "importHelpers": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "."
  },
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}

